fn main() {
    let trace_root: u256 = witness::TRACE_ROOT;
    let current: TraceRow = witness::TRACE_ROW;
    let next: TraceRow = witness::TRACE_NEXT_ROW;
    let fixed: FixedRow = witness::FIXED_ROW;
    let trace_path: (u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256) = witness::TRACE_PATH;
    let next_path: (u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256) = witness::TRACE_NEXT_PATH;
    let fixed_path: (u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256, u256) = witness::FIXED_PATH;
    let last: u32 = witness::FRI_LAST;
    let cp: u32 = witness::FRI_COMPOSITION;
    let x_inv: u32 = witness::DOMAIN_X_INVERSE;

    let state: ChannelState = sha256(EXPECTED_OUTPUTS_HASH);
    let state: ChannelState = channel_mix_256(state, FIXED_ROOT);
    let state: ChannelState = channel_mix_256(state, trace_root);
    let (state, alpha): (ChannelState, u32) = channel_draw_32(state, FIELD_MODULUS);
    let root0: u256 = witness::FRI_ROOT_0;
    let state: ChannelState = channel_mix_256(state, root0);
    let (state, beta0): (ChannelState, u32) = channel_draw_32(state, FIELD_MODULUS);
    let root1: u256 = witness::FRI_ROOT_1;
    let state: ChannelState = channel_mix_256(state, root1);
    let (state, beta1): (ChannelState, u32) = channel_draw_32(state, FIELD_MODULUS);
    let root2: u256 = witness::FRI_ROOT_2;
    let state: ChannelState = channel_mix_256(state, root2);
    let (state, beta2): (ChannelState, u32) = channel_draw_32(state, FIELD_MODULUS);
    let root3: u256 = witness::FRI_ROOT_3;
    let state: ChannelState = channel_mix_256(state, root3);
    let (state, beta3): (ChannelState, u32) = channel_draw_32(state, FIELD_MODULUS);
    let root4: u256 = witness::FRI_ROOT_4;
    let state: ChannelState = channel_mix_256(state, root4);
    let (state, beta4): (ChannelState, u32) = channel_draw_32(state, FIELD_MODULUS);
    let root5: u256 = witness::FRI_ROOT_5;
    let state: ChannelState = channel_mix_256(state, root5);
    let (state, beta5): (ChannelState, u32) = channel_draw_32(state, FIELD_MODULUS);
    let root6: u256 = witness::FRI_ROOT_6;
    let state: ChannelState = channel_mix_256(state, root6);
    let (state, beta6): (ChannelState, u32) = channel_draw_32(state, FIELD_MODULUS);
    let root7: u256 = witness::FRI_ROOT_7;
    let state: ChannelState = channel_mix_256(state, root7);
    let (state, beta7): (ChannelState, u32) = channel_draw_32(state, FIELD_MODULUS);
    let root8: u256 = witness::FRI_ROOT_8;
