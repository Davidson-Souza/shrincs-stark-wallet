type TraceRow = (u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32);
type FixedRow = (u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32);
type MerkleAcc = (u256, u32);

fn hash_trace_row(row: TraceRow) -> u256 {
    let (v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15, v16, v17, v18, v19, v20, v21, v22, v23, v24, v25, v26, v27, v28, v29, v30, v31, v32, v33): TraceRow = row;
    let ctx: Ctx8 = jet::sha_256_ctx_8_init();
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v0);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v1);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v2);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v3);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v4);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v5);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v6);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v7);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v8);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v9);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v10);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v11);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v12);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v13);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v14);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v15);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v16);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v17);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v18);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v19);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v20);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v21);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v22);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v23);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v24);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v25);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v26);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v27);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v28);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v29);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v30);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v31);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v32);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v33);
    jet::sha_256_ctx_8_finalize(ctx)
}

fn hash_fixed_row(row: FixedRow) -> u256 {
    let (v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15, v16, v17, v18): (u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32) = row;
    let ctx: Ctx8 = jet::sha_256_ctx_8_init();
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v0);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v1);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v2);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v3);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v4);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v5);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v6);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v7);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v8);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v9);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v10);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v11);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v12);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v13);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v14);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v15);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v16);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v17);
    let ctx: Ctx8 = jet::sha_256_ctx_8_add_4(ctx, v18);
    jet::sha_256_ctx_8_finalize(ctx)
}

fn merkle_step(sibling: u256, acc: MerkleAcc) -> MerkleAcc {
    let (current, path): MerkleAcc = acc;
    let next: u256 = match jet::divides_32(2, path) {
        false => sha256_pair(sibling, current),
        true => sha256_pair(current, sibling),
    };
    (next, jet::divide_32(path, 2))
}

fn merkle_verify_1(leaf: u256, path: u32, proof: u256, root: u256) {
    let acc: MerkleAcc = (leaf, path);
    let acc: MerkleAcc = merkle_step(proof, acc);
    let (computed, _): MerkleAcc = acc;
    assert!(jet::eq_256(computed, root));
}

fn merkle_verify_2(leaf: u256, path: u32, proof: (u256, u256), root: u256) {
    let (p0, p1): (u256, u256) = proof;
    let acc: MerkleAcc = (leaf, path);
    let acc: MerkleAcc = merkle_step(p0, acc);
    let acc: MerkleAcc = merkle_step(p1, acc);
    let (computed, _): MerkleAcc = acc;
    assert!(jet::eq_256(computed, root));
}

