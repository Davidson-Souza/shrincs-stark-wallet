fn composition_numerator(current: TraceRow, next: TraceRow, fixed: FixedRow, alpha: u32) -> u32 {
    let (s0, s1, s2, s3, s4, s5, s6, s7, r0, r1, r2, r3, r4, r5, r6, r7, t0, t1, t2, t3, t4, t5, t6, t7, index, path_acc, direction, d0, d1, d2, d3, d4, d5, d6): TraceRow = current;
    let (n0, n1, n2, n3, n4, n5, n6, n7, nr0, nr1, nr2, nr3, nr4, nr5, nr6, nr7, nt0, nt1, nt2, nt3, nt4, nt5, nt6, nt7, next_index, next_path_acc, next_direction, nd0, nd1, nd2, nd3, nd4, nd5, nd6): TraceRow = next;
    let (member_init, perm, member_path, member_final, rehash, acc_phase, new_chain, switch_signer, final_phase, idle, c0, c1, c2, c3, c4, c5, c6, c7, level_weight): FixedRow = fixed;
    let x0: u32 = add_mod(s0, c0);
    let x0_2: u32 = mul_mod(x0, x0);
    let x0_4: u32 = mul_mod(x0_2, x0_2);
    let x0_5: u32 = mul_mod(x0_4, x0);
    let x1: u32 = add_mod(s1, c1);
    let x1_2: u32 = mul_mod(x1, x1);
    let x1_4: u32 = mul_mod(x1_2, x1_2);
    let x1_5: u32 = mul_mod(x1_4, x1);
    let x2: u32 = add_mod(s2, c2);
    let x2_2: u32 = mul_mod(x2, x2);
    let x2_4: u32 = mul_mod(x2_2, x2_2);
    let x2_5: u32 = mul_mod(x2_4, x2);
    let x3: u32 = add_mod(s3, c3);
    let x3_2: u32 = mul_mod(x3, x3);
    let x3_4: u32 = mul_mod(x3_2, x3_2);
    let x3_5: u32 = mul_mod(x3_4, x3);
    let x4: u32 = add_mod(s4, c4);
    let x4_2: u32 = mul_mod(x4, x4);
    let x4_4: u32 = mul_mod(x4_2, x4_2);
    let x4_5: u32 = mul_mod(x4_4, x4);
    let x5: u32 = add_mod(s5, c5);
    let x5_2: u32 = mul_mod(x5, x5);
    let x5_4: u32 = mul_mod(x5_2, x5_2);
    let x5_5: u32 = mul_mod(x5_4, x5);
    let x6: u32 = add_mod(s6, c6);
    let x6_2: u32 = mul_mod(x6, x6);
    let x6_4: u32 = mul_mod(x6_2, x6_2);
    let x6_5: u32 = mul_mod(x6_4, x6);
    let x7: u32 = add_mod(s7, c7);
    let x7_2: u32 = mul_mod(x7, x7);
    let x7_4: u32 = mul_mod(x7_2, x7_2);
    let x7_5: u32 = mul_mod(x7_4, x7);
    let residual_0: u32 = sub_mod(s0, t0);
