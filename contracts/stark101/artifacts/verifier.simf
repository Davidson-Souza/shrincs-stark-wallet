    let a: u32 = 56756;
    let b: u32 = 56756;
    let c: u32 = mul_mod(a, b);
    assert!(jet::eq_32(c, 18063));
}
fn test_mul_mod_2() {
    let a: u32 = 1734477367;
    let b: u32 = 1033050121;
    let c: u32 = mul_mod(a, b);
    assert!(jet::eq_32(c, 510964216));
}
fn test_div_mod() {
    let a: u32 = 124245436;
    let b: u32 = 980943291;
    let c: u32 = div_mod(a, b);
    let d: u32 = mul_mod(c, b);
    assert!(jet::eq_32(d, a));
}
