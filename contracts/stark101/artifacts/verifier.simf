    let a: u32 = 3221225473;
    let b: u32 = 1;
    let c: u32 = add_mod(a, b);
    assert!(jet::eq_32(c, 1));
}
fn test_sub_mod() {
    let a: u32 = 3221225473;
    let b: u32 = 1;
    let c: u32 = sub_mod(a, b);
    assert!(jet::eq_32(c, 3221225472));
}
