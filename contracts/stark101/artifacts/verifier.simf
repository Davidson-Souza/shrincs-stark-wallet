    let a: u32 = 2915689029;
    let b: u32 = 1944025131;
    let c: u32 = div_mod(a, b);
    assert!(jet::eq_32(c, 3199116755));
}
fn test_exp_mod() {
    let a: u32 = 2;
    let b: u32 = 32;
    let c: u32 = exp_mod(a, b);
    assert!(jet::eq_32(c, 1073741823));
}
fn test_exp_mod_2() {
    let a: u32 = 1734477367;
    let b: u32 = 365;
    let c: u32 = exp_mod(a, b);
    assert!(jet::eq_32(c, 1033050121));
}
type FibSquareCoeffs = (u32, u32, u32);
type Eval = (u32, MerkleProof16);
type FibSquareEvals = (Eval, Eval, Eval);
fn fibsquare_read_coefficients(state: ChannelState) -> (ChannelState, FibSquareCoeffs) {
    let (state, alpha0): (ChannelState, u32) = channel_draw_32(state, 3221225473);
    let (state, alpha1): (ChannelState, u32) = channel_draw_32(state, 3221225473);
    let (state, alpha2): (ChannelState, u32) = channel_draw_32(state, 3221225473);
    (state, (alpha0, alpha1, alpha2))
}
fn read_eval_checked(state: ChannelState, eval: Eval, idx: u32, p_mt_root: u256) -> ChannelState {
    let (p_ev, p_proof): Eval = eval;
    let (_, auth_path): (bool, u32) = jet::add_32(idx, 8192);
    merkle_verify_16(sha256_32(p_ev), auth_path, p_proof, p_mt_root);
    channel_mix_32(state, p_ev)
}
fn fibsquare_read_evaluations_checked(state: ChannelState, evals: FibSquareEvals, idx: u32, p_mt_root: u256) -> ChannelState {
    let (f_x, f_gx, f_ggx): FibSquareEvals = evals;
    let state: ChannelState = read_eval_checked(state, f_x, idx, p_mt_root);
    let (_, idx): (bool, u32) = jet::add_32(idx, 8);
    let state: ChannelState = read_eval_checked(state, f_gx, idx, p_mt_root);
    let (_, idx): (bool, u32) = jet::add_32(idx, 8);
    let state: ChannelState = read_eval_checked(state, f_ggx, idx, p_mt_root);
    state
}
fn fibsquare_calc_x(idx: u32) -> u32 {
    mul_mod(5, exp_mod(1734477367, idx))
}
fn fibsquare_eval_p0(x: u32, f_x: u32) -> u32 {
    div_mod(sub_mod(f_x, 1), sub_mod(x, 1))
}
fn fibsquare_eval_p1(x: u32, f_x: u32) -> u32 {
    div_mod(sub_mod(f_x, 2338775057), sub_mod(x, 2450347685))
}
fn fibsquare_eval_p2(x: u32, f_x: u32, f_gx: u32, f_ggx: u32) -> u32 {
    let num0: u32 = sub_mod(f_ggx, add_mod(mul_mod(f_x, f_x), mul_mod(f_gx, f_gx)));
    let num1: u32 = mul_mod(mul_mod(sub_mod(x, 2342081930), sub_mod(x, 2450347685)), sub_mod(x, 532203874));
    let den: u32 = sub_mod(exp_mod(x, 1024), 1);
    div_mod(mul_mod(num0, num1), den)
}
fn fibsquare_eval_cp(x: u32, a0: u32, a1: u32, a2: u32, f_x: u32, f_gx: u32, f_ggx: u32) -> u32 {
    let p0: u32 = fibsquare_eval_p0(x, f_x);
    let p1: u32 = fibsquare_eval_p1(x, f_x);
    let p2: u32 = fibsquare_eval_p2(x, f_x, f_gx, f_ggx);
    add_mod(add_mod(mul_mod(p0, a0), mul_mod(p1, a1)), mul_mod(p2, a2))
}
fn fibsquare_compose(x: u32, coeffs: FibSquareCoeffs, evals: FibSquareEvals) -> u32 {
    let (a0, a1, a2): FibSquareCoeffs = coeffs;
    let (e0, e1, e2): FibSquareEvals = evals;
    let (f_x, _): Eval = e0;
    let (f_gx, _): Eval = e1;
    let (f_ggx, _): Eval = e2;
    fibsquare_eval_cp(x, a0, a1, a2, f_x, f_gx, f_ggx)
}
fn test_fibsquare_calc_x() {
    let x: u32 = fibsquare_calc_x(365);
    assert!(jet::eq_32(x, 1944025132));
}
fn test_fibsquare_eval_p0() {
    let x: u32 = 1944025132;
    let f_x: u32 = 2915689030;
    let p0: u32 = fibsquare_eval_p0(x, f_x);
    assert!(jet::eq_32(p0, 3199116755));
}
fn test_fibsquare_eval_cp() {
    let (a0, a1, a2): FibSquareCoeffs = (
        2843266690,
        519917353,
        1882164991
    );
    let (f_x, f_gx, f_ggx): (u32, u32, u32) = (
        2915689030,
        2938213560,
        2430756332
    );
    let x: u32 = 1944025132;
    let cp: u32 = fibsquare_eval_cp(x, a0, a1, a2, f_x, f_gx, f_ggx);
    assert!(jet::eq_32(cp, 587367660));
}
fn test_fibsquare_read_coefficients() {
    let state: ChannelState = 30579157067350379179940449776878177171877254029206216849297077040602409619412;
    let (state, (alpha0, alpha1, alpha2)): (ChannelState, FibSquareCoeffs) = fibsquare_read_coefficients(state);
    assert!(jet::eq_32(alpha0, 2843266690));
    assert!(jet::eq_32(alpha1, 519917353));
    assert!(jet::eq_32(alpha2, 1882164991));
}
type FriAcc = (u32, u32, u32, u32);
type FriLayer = (u256, u32, u32, MerkleProof16, u32, MerkleProof16);
type FriLastLayer = u32;
fn fri_read_commitment(layer: FriLayer, state: ChannelState) -> ChannelState {
    let (cp_mt_root, beta, _, _, _, _): FriLayer = layer;
    let state: ChannelState = channel_mix_256(state, cp_mt_root);
    let (state, random): (ChannelState, u32) = channel_draw_32(state, 3221225473);
    assert!(jet::eq_32(random, beta));
    state
}
fn fri_read_commitments_16(layers: List<FriLayer, 16>, last_layer: FriLastLayer, state: ChannelState) -> ChannelState {
    let state: ChannelState = fold::<fri_read_commitment, 16>(layers, state);
    channel_mix_32(state, last_layer)
}
fn fri_eval_cp_next(cpa_ev: u32, cpb_ev: u32, x: u32, beta: u32) -> u32 {
    let op0: u32 = div_mod(add_mod(cpa_ev, cpb_ev), 2);
    let op1: u32 = div_mod(sub_mod(cpa_ev, cpb_ev), mul_mod(x, 2));
    add_mod(op0, mul_mod(op1, beta))
}
fn compute_auth_path(idx: u32, domain_size: u32) -> (u32, u32) {
    let (_, cpa_path): (bool, u32) = jet::add_32(jet::modulo_32(idx, domain_size), domain_size);
    let (_, cpb_idx): (bool, u32) = jet::add_32(idx, jet::divide_32(domain_size, 2));
    let (_, cpb_path): (bool, u32) = jet::add_32(jet::modulo_32(cpb_idx, domain_size), domain_size);
    (cpa_path, cpb_path)
}
fn fri_verify_layer(layer: FriLayer, acc: FriAcc) -> FriAcc {
    let (cp_mt_root, beta, cpa_ev, cpa_proof, cpb_ev, cpb_proof): FriLayer = layer;
    let (idx, x, cp_ev, domain_size): FriAcc = acc;
    assert!(jet::eq_32(cp_ev, cpa_ev));
    let (cpa_path, cpb_path): (u32, u32) = compute_auth_path(idx, domain_size);
    merkle_verify_16(sha256_32(cpa_ev), cpa_path, cpa_proof, cp_mt_root);
    merkle_verify_16(sha256_32(cpb_ev), cpb_path, cpb_proof, cp_mt_root);
    let cp_ev_next: u32 = fri_eval_cp_next(cpa_ev, cpb_ev, x, beta);
    let domain_size_next: u32 = jet::divide_32(domain_size, 2);
    (idx, mul_mod(x, x), cp_ev_next, domain_size_next)
}
fn fri_verify_16(fri_layers: List<FriLayer, 16>, last_layer: FriLastLayer, idx: u32, x0: u32, cp_ev: u32) {
    let acc: FriAcc = (idx, x0, cp_ev, 8192);
    let (_, _, cp_last, _): FriAcc = fold::<fri_verify_layer, 16>(fri_layers, acc);
    assert!(jet::eq_32(cp_last, last_layer));
}
type FibSquareProof = (u256, FibSquareEvals, List<FriLayer, 16>, FriLastLayer);
fn verify_proof(proof: FibSquareProof) {
    let (p_mt_root, evals, fri_layers, last_layer): FibSquareProof = proof;
    let state: ChannelState = sha256(p_mt_root);
    let (state, coeffs): (ChannelState, FibSquareCoeffs) = fibsquare_read_coefficients(state);
    let state: ChannelState = fri_read_commitments_16(fri_layers, last_layer, state);
    let (state, idx): (ChannelState, u32) = channel_draw_32(state, 8192);
    let state: ChannelState = fibsquare_read_evaluations_checked(state, evals, idx, p_mt_root);
    let x: u32 = fibsquare_calc_x(idx);
    let cp_ev: u32 = fibsquare_compose(x, coeffs, evals);
    fri_verify_16(fri_layers, last_layer, idx, x, cp_ev);
}
fn main() {
    let p_mt_root: u256 = witness::P_MT_ROOT;
    let p_evals: FibSquareEvals = witness::P_EVALS;
    let fri_layers: List<FriLayer, 16> = witness::FRI_LAYERS;
    let fri_last_layer: FriLastLayer = witness::FRI_LAST_LAYER;
    let proof: FibSquareProof = (p_mt_root, p_evals, fri_layers, fri_last_layer);
    verify_proof(proof);
}
